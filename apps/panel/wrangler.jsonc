{
  "name": "panel",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "panel.edushot.pl",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
