{
  "name": "edushot-admin-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["30 2 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TUTOR_INVITE_REDIRECT": "https://panel.edushot.workers.dev/tutor",
    "ALLOWED_ORIGINS": "https://panel.edushot.workers.dev"
  }
}
